{
  "manifest_version": 3,
  "name": "Reddit Jupy",
  "version": "1.0",
  "description": "Reddit as a Jupyter/Kaggle notebook interface",
  "content_scripts": [
    {
      "matches": [
        "*://old.reddit.com/*",
        "*://www.reddit.com/*"
      ],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}
